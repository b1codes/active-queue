{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouTube Data API v3 error envelope",
  "description": "YouTubeProvider._api_get maps errors[0].reason (quotaExceeded, dailyLimitExceeded, playlistNotFound) to SPEC \u00a79.7 codes.",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "errors"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
