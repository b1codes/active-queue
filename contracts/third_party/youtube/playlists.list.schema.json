{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouTube Data API v3 playlists.list (part=snippet,contentDetails)",
  "description": "Fields YouTubeProvider.get_playlist_metadata reads. Extra fields are allowed: the API adds them freely.",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "snippet",
          "contentDetails"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "snippet": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "thumbnails": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "contentDetails": {
            "type": "object",
            "required": [
              "itemCount"
            ],
            "properties": {
              "itemCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
