# ActiveQueue API — Local development environment
# Copy to .env and adjust as needed. Never commit .env itself.

# Environment: local | dev | staging | prod
ENV=local

# GCP project ID — uses 'demo-' prefix locally so Firebase emulators require
# no authentication. Swap to your real GCP project ID in staging/prod.
GCP_PROJECT_ID=demo-activequeue-local

# Firestore emulator (must be UNSET in production — see SPEC §10.3)
FIRESTORE_EMULATOR_HOST=localhost:9090

# Firebase Auth emulator (must be UNSET in production — see SPEC §10.3)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Content provider: fixture | youtube
CONTENT_PROVIDER=fixture

# YouTube API key (unset while content_provider=fixture)
# YOUTUBE_API_KEY=

# Logging
DEBUG=false
LOG_LEVEL=INFO
