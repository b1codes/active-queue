rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Sources collection: sources/{sourceId}
    match /sources/{sourceId} {
      allow read, write: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    // Feed items collection: feed_items/{feedItemId}
    match /feed_items/{feedItemId} {
      allow read, write: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    // Shared content cache collection: content_cache/{contentId} (read-only for clients)
    match /content_cache/{contentId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server backend writes via Admin SDK / service account
    }

    // Sessions collection: sessions/{sessionId}
    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    // Activities catalog: activities/{activityId} (read-only for clients)
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
