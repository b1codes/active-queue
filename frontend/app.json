{
  "expo": {
    "name": "ActiveQueue",
    "slug": "activequeue",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "activequeue",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0909"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.b1codes.activequeue",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "vnd.youtube",
          "youtube",
          "spotify",
          "strava",
          "strong"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0909"
      },
      "package": "com.b1codes.activequeue"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
